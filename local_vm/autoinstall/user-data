#cloud-config
autoinstall:
  version: 1
  locale: zh_CN.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: w49-edge-lab
    username: bot
    password: "w49-edge-lab"
  ssh:
    install-server: true
    allow-pw: true
  packages:
    - openssh-server
    - python3
    - python3-pip
    - python3-venv
    - git
    - curl
    - wget
    - android-tools-adb
    - rsync
    - jq
    - build-essential
  storage:
    layout:
      name: direct
  late-commands:
    - curtin in-target --target=/target -- bash -c "echo 'bot:w49-edge-lab' | chpasswd"
    - curtin in-target --target=/target -- bash -c "echo 'bot ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/bot && chmod 440 /etc/sudoers.d/bot"
