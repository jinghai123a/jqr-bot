{
  "upstream": {
    "repo": "https://github.com/yee338024/55chat-bot",
    "commit": "a20b4841a068bed7031c9afef01672f94cd92990",
    "commit_url": "https://github.com/yee338024/55chat-bot/commit/a20b4841a068bed7031c9afef01672f94cd92990",
    "docs_tree": "docs/{guide,msg,websocket,group}.md + readme.md",
    "vendor_snapshot": "config/55m-knowledge/vendor/55chat-bot-a20b484/"
  },
  "helper": "68助手 / 55助手 / 66助手（桌面 WS 协议同一套）",
  "activation": "使用前须在助手「设置」中激活卡密",
  "pricing_a20b484": {
    "service": "收/发消息",
    "month": "120 U",
    "quarter_8off": "300 U",
    "year_6off": "900 U",
    "note": "a20b484 起仅保留收/发一档，删除原「仅收取消息 80U」"
  },
  "endpoints": {
    "ws_doc_default": "ws://127.0.0.1:5599",
    "ws_local_v168": "ws://127.0.0.1:5600",
    "http_settings": "http://127.0.0.1:5500",
    "env": "BOT_55WS_URL 覆盖文档端口"
  },
  "transport": {
    "format": "JSON",
    "handshake_in": {"message": "Hello"},
    "heartbeat_sec": 3,
    "heartbeat": {"operator": "network", "data": {"networkStatusType": "socketLogin"}},
    "disconnect": {"operator": "network", "data": {"networkStatusType": "socketLoginout"}},
    "reconnect": "客户端自动重连直至成功"
  },
  "outbound": {
    "sendMsg": {
      "type": "sendMsg",
      "group": {
        "id": "numeric groupId",
        "data_type": "group",
        "text": {"list": [{"type": "text", "values": {"chatType": 0, "content": "..."}}]}
      },
      "friend": {"id": "numeric uid", "data_type": "friend"},
      "multiline": "content 内 \\n",
      "notice": "chatType 8 + bfAll",
      "shutup_notify": "chatType 50 + bfShutup"
    },
    "sendFile": {
      "type": "sendFile",
      "data": {"file": "Windows绝对路径", "type": "group|friend", "id": "groupId|friendId"},
      "project_use": "结算三图 PC28→六合→流水"
    },
    "getGroups": {
      "type": "getGroups",
      "response": {"type": "getGroups", "data": [{"id": 0, "name": "群名", "memberCount": 0}]},
      "project_use": "解析 DESKTOP_GROUP_ID / 群名匹配"
    },
    "getApiUrl": {"type": "getApiUrl"},
    "restartApp": {"type": "restartApp"},
    "request_proxy": {
      "type": "request",
      "examples": ["UserInfo", "ContactsList", "GroupMemberList", "GroupDetail", "GroupUpdate"]
    }
  },
  "inbound_operators": {
    "msgNew": "新消息（好友/群/系统通知）",
    "groupUpdate": "群名等变更",
    "msgListPropertyUpdate": "发送结果 readStatus",
    "network": "心跳/断线"
  },
  "inbound_msgNew": {
    "group_key_fields": ["sendUid", "groupId", "content", "msgType", "isSelf", "groupName", "customMsgId"],
    "friend_key_fields": ["sendUid", "receiveUid", "content", "isSelf"],
    "messengerId_map": "sendUid（数字 uid）→ panel.users[].messengerId；identify 常为 -- 不可靠",
    "ignore_inbound": "isSelf=false 且 msgType=0 为真实用户指令",
    "echo_outbound": "isSelf=true 可用于回显检测（desktop_local_announce）",
    "notification_types": ["groupShutupAll", "operatorReadCancel"]
  },
  "msg_types": {
    "0": "文本 MESSAGE_TYPE_TEXT",
    "1": "图片",
    "7": "文件",
    "8": "通知",
    "12": "骰子",
    "50": "群系统通知（禁言/阅后即焚等）"
  },
  "send_ack": {
    "operator": "msgListPropertyUpdate",
    "success": "readStatus=1（含 MsgID/time）",
    "fail": "readStatus=0",
    "env_optional": "DESKTOP_WS_ACK_OPTIONAL=1 超时仍发"
  },
  "group_ops": {
    "SHUTUP": 11,
    "NOTICE": 12,
    "doc": "group.md 枚举；更新群公告后须再 sendMsg chatType=8"
  },
  "project_mapping": {
    "扣1_下注": "msgNew → handle_command → sendMsg",
    "公告_warn_close_open": "sendMsg 长文",
    "结算三图": "sendFile×3",
    "ADD_绑ID": "协议无；走 ADB UI",
    "认人": "sendUid 非 identify"
  },
  "not_in_protocol": ["ADD好友点头像", "ADB 三图 UI 点击链", "Panel 账务"],
  "executor_env": {
    "BOT_EXECUTOR": "ws | adb（互斥）",
    "BOT_55WS_URL": "ws://127.0.0.1:5600",
    "DESKTOP_GROUP_ID": "492316",
    "BOT_TARGET_GROUP": "苍井空测试",
    "DESKTOP_WS_ACK_OPTIONAL": "1"
  },
  "project_paths": [
    "protocol/55ws-client/watch.js",
    "protocol/55ws-client/local_desktop_bot.js",
    "scripts/desktop_local_announce.py",
    "scripts/desktop_local_stack.py",
    "scripts/desktop_ws_verify.py",
    "scripts/desktop_ws_sniff.py"
  ]
}
