{
  "upstream_primary": {
    "name": "68chat-bot 官方文档站",
    "docs_base": "https://yee338024.github.io/68chat-bot/",
    "guide": "https://yee338024.github.io/68chat-bot/guide.html",
    "websocket": "https://yee338024.github.io/68chat-bot/websocket.html",
    "http": "https://yee338024.github.io/68chat-bot/http.html",
    "msg": "https://yee338024.github.io/68chat-bot/msg.html",
    "full_spec": "config/55m-knowledge/68chat-protocol.json",
    "vendor_snapshot": "config/55m-knowledge/vendor/68chat-bot/"
  },
  "upstream_legacy": {
    "repo": "https://github.com/yee338024/55chat-bot",
    "commit": "a20b4841a068bed7031c9afef01672f94cd92990",
    "note": "与 68 协议同源；68 站为当前生产助手文档",
    "vendor_snapshot": "config/55m-knowledge/vendor/55chat-bot-a20b484/"
  },
  "helper": "68助手（本机桌面 WS 执行器）",
  "activation": "使用前须在助手「设置」中激活卡密",
  "pricing_68_official": {
    "receive_only": {"month": "60 U", "quarter_8off": "150 U", "year_6off": "450 U"},
    "send_receive": {"month": "120 U", "quarter_8off": "300 U", "year_6off": "900 U"}
  },
  "endpoints": {
    "ws_doc_default": "ws://127.0.0.1:5599",
    "ws_local_v168": "ws://127.0.0.1:5600",
    "http_api_doc": "http://127.0.0.1:5598",
    "http_settings_local": "http://127.0.0.1:5500",
    "full_spec": "config/55m-knowledge/68chat-protocol.json",
    "env": "BOT_55WS_URL / BOT_68HTTP_URL"
  },
  "transport": {
    "format": "JSON",
    "handshake_in": {"message": "Hello"},
    "heartbeat_sec": 3,
    "heartbeat": {"operator": "network", "data": {"networkStatusType": "socketLogin"}},
    "disconnect": {"operator": "network", "data": {"networkStatusType": "socketLoginout"}},
    "reconnect": "客户端自动重连直至成功"
  },
  "custom_msg_id": {
    "required_68": true,
    "rules": "11位数字；不能重复；不能以0开头",
    "sendMsg_group": "data.custom_msg_id",
    "sendFile": "顶层 custom_msg_id（与 id 并列）",
    "ack_match": "msgListPropertyUpdate.list[].customMsgId",
    "project_impl": "scripts/desktop_local_announce.py _gen_custom_msg_id"
  },
  "outbound": {
    "sendMsg": {
      "type": "sendMsg",
      "group": {
        "id": "numeric groupId",
        "data_type": "group",
        "custom_msg_id": "11位，放 data 内",
        "text": {"list": [{"type": "text", "values": {"chatType": 0, "content": "..."}}]}
      },
      "friend": {"id": "numeric uid", "data_type": "friend", "custom_msg_id": "必填（68 websocket 示例）"},
      "multiline": "content 内 \\n",
      "notice": "chatType 8 + bfAll",
      "shutup_notify": "chatType 50 + bfShutup"
    },
    "sendFile": {
      "type": "sendFile",
      "custom_msg_id": "顶层必填（68）",
      "data": {"file": "Windows绝对路径", "type": "group|friend", "id": "groupId|friendId"},
      "project_use": "结算三图 PC28→六合→流水"
    },
    "getGroups": {
      "type": "getGroups",
      "response": {"type": "getGroups", "data": [{"id": 0, "name": "群名", "memberCount": 0}]},
      "project_use": "解析 DESKTOP_GROUP_ID / 群名匹配"
    },
    "getApiUrl": {"type": "getApiUrl"},
    "restart68": {"type": "restart68", "note": "55 旧文档为 restartApp"},
    "request_proxy": {
      "type": "request",
      "examples": ["UserInfo", "ContactsList", "GroupMemberList", "GroupDetail", "GroupUpdate", "GroupMemberShutup"]
    }
  },
  "inbound_operators": {
    "msgNew": "新消息（好友/群/系统通知）",
    "groupUpdate": "群名等变更",
    "msgListPropertyUpdate": "发送结果 readStatus + customMsgId",
    "recall_msg": "双向删除撤回（68 新增）",
    "network": "心跳/断线"
  },
  "inbound_msgNew": {
    "group_key_fields": ["sendUid", "groupId", "content", "msgType", "isSelf", "groupName", "customMsgId"],
    "friend_key_fields": ["sendUid", "receiveUid", "content", "isSelf"],
    "messengerId_map": "sendUid → panel.users[].messengerId；identify 常为 --",
    "ignore_inbound": "isSelf=false 且 msgType=0 为真实用户指令",
    "echo_outbound": "isSelf=true + content 匹配用于 OUT 检测",
    "notification_types": ["groupShutupAll", "operatorReadCancel"]
  },
  "msg_types": {
    "0": "文本", "1": "图片", "7": "文件", "8": "通知", "12": "骰子", "50": "群系统通知"
  },
  "send_ack": {
    "operator": "msgListPropertyUpdate",
    "success": "readStatus=1",
    "fail": "readStatus=0",
    "match_key": "list[].customMsgId 优先于顶层 id",
    "env_optional": "DESKTOP_WS_ACK_OPTIONAL=1"
  },
  "project_mapping": {
    "扣1_下注": "msgNew → Panel/handle_command → sendMsg+custom_msg_id",
    "公告": "sendMsg 长文",
    "结算三图": "sendFile×3 + custom_msg_id",
    "ADD_绑ID": "ADB UI，协议无"
  },
  "executor_env": {
    "BOT_EXECUTOR": "ws",
    "BOT_55WS_URL": "ws://127.0.0.1:5600",
    "BOT_68HTTP_URL": "http://127.0.0.1:5598",
    "DESKTOP_GROUP_ID": "492316",
    "BOT_TARGET_GROUP": "苍井空测试",
    "DESKTOP_WS_ACK_OPTIONAL": "1"
  },
  "project_paths": [
    "scripts/desktop_local_announce.py",
    "protocol/55ws-client/local_desktop_bot.js",
    "config/55m-knowledge/desktop-protocol.json"
  ]
}
