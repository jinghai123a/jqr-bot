# 本地 VMware 实验机（镜像 APS Linux 环境）
# 复制为 config/local-vm.env 后填写 VM_IP（Ubuntu 装完、SSH 通了再填）

VM_HOST=192.168.233.128
VM_SSH_PORT=22
VM_USER=bot
VM_PASSWORD=w49-edge-lab
# 55M 实验专区（VM 内 /opt/55m-lab，见 local_vm/README-55M.md）
VM_55M_ROOT=/opt/55m-lab
VM_BOT_ROOT=/opt/55m-lab/app
VM_SSH_KEY_PATH=

# edge（与 APS 一致）
EDGE_BRAIN_PORT=8790
EDGE_BRAIN_JWT_SECRET=change-me-in-production
# 预签发 JWT（python scripts/edge_issue_jwt.py --write-edge-config）
EDGE_BRAIN_JWT=
BOT_PANEL_URL=http://127.0.0.1:3000

# 宿主机项目路径（默认仓库根）
HOST_PROJECT_ROOT=

# VMware（setup_vm.ps1 写入）
VM_NAME=w49-edge-lab
VM_DIR=C:\Users\Public\虚拟机\w49-edge-lab
