# VMOS OpenAPI 出口代理 — 复制为 config/vmos-proxy.env（chmod 600，勿提交 git）
# 用途：隧道 SSH IP 被 ban 时，用干净代理 IP 调 api.vmoscloud.com
# 接口：openOnlineAdb → wait taskStatus=3 → adb（见 OpenAPI 文档）
#
# 优先级：进程环境变量 > 本文件 > config/vmos-api.env > VPS config/vmos-api.env
# 格式：http://user:pass@host:port  或  https://host:port
# socks5 需：pip install PySocks
VMOS_API_PROXY=http://user:pass@clean-proxy.example:8080
