# 复制为 config/bot-start.env（本机 / VPS 各自一份，均已 gitignore）
# · 本机：powershell -File scripts/setup_local.ps1 自动生成，仅供 botctl/pytest/runtime
# · VPS：由 install_lean_vps_stack 在服务器侧合并 ENV_LINES，勿 scp 本机文件覆盖
BOT_ROLE=
BOT_LISTENER_ADB_PORT=58433
BOT_CLICKER_ADB_PORT=55612
BOT_LISTENER_ID=bot-4
# 双进程物理隔离（L3 架构）
BOT_DUAL_PROCESS=1
# 边缘执行器：生产禁 AutoJs6 灌字 / edge_adb_agent（见 config/55m-knowledge/executor-matrix.json）
BOT_EDGE_AUTOJS6=0
BOT_EDGE_ADB_AGENT=0
# §4 公告正文锁定（忽略面板脏模板）；左机须 Pixel XL / V03
BOT_ANNOUNCE_LOCKED=1
BOT_CLICKER_EXPECT_MODEL=Pixel XL
BOT_OPEN_FALLBACK_SEC=0
BOT_ADB_ISOLATED=1
BOT_LISTENER_ADB_SERVER_PORT=5038
BOT_CLICKER_ADB_SERVER_PORT=5039
BOT_SRE_LOOP_SEC=30
BOT_SRE_HEAL_COOLDOWN_SEC=60
BOT_SRE_HEAL_STREAK=3
BOT_SRE_STARTUP_GRACE_SEC=90
BOT_PHYSICAL_LAG_BUDGET_SEC=1.0
BOT_ANNOUNCE_LOOP_SEC=0.25
BOT_CLICKER_IDS=bot-3
# 左机 UI 发图 + 28.run 结算内闭环（双进程：不经右机 settlement 线程）
BOT_CLICKER_SEND_IMAGES=1
BOT_CLICKER_SETTLE=1

# 双进程线程隔离（各云机独立进程，禁止抢线）
BOT_LISTENER_OUTBOUND_POOL_MAX=10
BOT_CLICKER_OUTBOUND_POOL_MAX=3
BOT_LISTENER_LOG_WORKERS=3
BOT_CLICKER_LOG_WORKERS=1
BOT_CLICKER_BUSY_STALE_SEC=180
BOT_PANEL_HTTP_TIMEOUT_SEC=3
BOT_CLICKER_CONTEXT_REFRESH_SEC=10

# Gateway 毫秒级热路径
BOT_GATEWAY_ENABLED=1
BOT_GATEWAY_URL=http://127.0.0.1:8765
BOT_GATEWAY_TIMEOUT_SEC=0.2
BOT_GATEWAY_WARM_SEC=5

# 时间对齐（28.run API + NTP）
BOT_TIME_MAX_SKEW_SEC=1.0
BOT_DRAW_FETCH_SEC=1
BOT_WARN_ANNOUNCE_SEC=70
BOT_CLOSE_ANNOUNCE_SEC=15

# 公告 UI 验发硬截止（毫秒）
BOT_LISTENER_ANNOUNCE_VERIFY_MAX_MS=2000
BOT_LISTENER_ANNOUNCE_TRUST_FALLBACK=1

# 发送快路径
BOT_LISTENER_TRUST_SEND=1
BOT_LISTENER_SEND_FIRE=1
BOT_LISTENER_PURE_PIPE=1
BOT_OUTBOUND_POOL_MAX=10
BOT_OUTBOUND_DEDUP_SEC=8

# Panel 对齐
CONTEXT_REFRESH_SEC=1
PANEL_CHECK_TTL_SEC=1

# 右机：禁止自动 Back/冷启动乱导航（仅消息列表点群 + 手动 --recover-group）
BOT_LISTENER_AUTO_RECOVER=0
BOT_LISTENER_STAY_IN_GROUP=0
BOT_LISTENER_STAY_LOOP=1
BOT_LEAN_HEAL_COOLDOWN_SEC=3600
BOT_LEAN_WATCH_FAIL_STREAK=5

# 发图
BOT_IMG_NEWEST_AT=top
BOT_IMG_LOCKED=1
BOT_IMG_FAST=1
BOT_IMG_PINNED=1
BOT_IMG_TRUST_CLICK=1
BOT_IMG_UPLOAD_WAIT_SEC=10
BOT_IMG_UPLOAD_POLL_SEC=0.35
BOT_IMG_UPLOAD_MIN_SETTLE_SEC=2.5
BOT_IMG_UPLOAD_GALLERY_FAST=1
BOT_CAPTURE_BURN_DELAY_SEC=90
BOT_LISTENER_COMPOSER_CLEAN_DELAY_SEC=90
BOT_GALLERY_PUSH_SETTLE_SEC=0.28
BOT_IMG_CHECK_W_SEC=0.10
BOT_IMG_SEND_W_SEC=0.22
BOT_IMG_ATTACH_W_SEC=0.32
BOT_CLICKER_TAP_MS=50
BOT_SETTLE_CAPTURE_ENABLED=1

# VMOS OpenAPI ADB 凭证（padApi/adb expireMinutes 1440~10080；控制台「24小时」=1440）
BOT_VMOS_ADB_EXPIRE_MINUTES=1440
# 距 EXPIRE_TIME 提前多少分钟算 urgent（仅手动 --expire-if-needed，不进 cron）
BOT_VMOS_REFRESH_BUFFER_MINUTES=120
# 群维护窗：优先在此时段 OpenAPI 续隧道（北京时间）
BOT_VMOS_MAINTENANCE_START=19:00
BOT_VMOS_MAINTENANCE_END=19:30
