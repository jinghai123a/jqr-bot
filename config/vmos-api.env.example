# VMOS Cloud API — 复制为 config/vmos-api.env 并 chmod 600
VMOS_ACCESS_KEY=your_access_key
VMOS_SECRET_KEY=your_secret_key
# 可选：OpenAPI 出口代理（亦可单独放 config/vmos-proxy.env）
# VMOS_API_PROXY=http://user:pass@clean-proxy.example:8080
# 回调 URL：VMOS 控制台 → 开发者 → API → 回调URL
VMOS_CALLBACK_URL=http://195.114.193.136:3000/api/vmos/callback
